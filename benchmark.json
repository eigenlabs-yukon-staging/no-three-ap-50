{
  "schemaVersion": 2,
  "name": "no-three-ap-50",
  "tracks": [
    {
      "name": "main",
      "description": "no-three-ap-50",
      "category": "math",
      "mode": "pareto",
      "promotionMode": "automatic",
      "direction": "+",
      "objectives": [
        {
          "name": "set_size",
          "direction": "+"
        }
      ],
      "paretoPolicies": {
        "scoring": {},
        "validity": {}
      },
      "editablePaths": [
        "submission"
      ],
      "submissionAdmission": {
        "version": 1,
        "submissionReferencesEnabled": false
      },
      "setupCommand": [
        "llm-verifier",
        "intake",
        "--root",
        ".",
        "--out",
        ".yukon/work/intake.json"
      ],
      "benchmarkCommand": [
        "llm-verifier",
        "finalize",
        "--intake",
        ".yukon/work/intake.json",
        "--initial",
        ".yukon/work/initial.json",
        "--initial-review",
        ".yukon/work/review.json",
        "--score",
        ".yukon/score.json",
        "--dossier",
        ".yukon/dossier.json"
      ],
      "scorePath": ".yukon/score.json",
      "maxSubmissionBytes": 262144,
      "runner": {
        "provider": "github-actions",
        "workflow": "benchmark.yml",
        "scoreArtifactName": "benchmark-score",
        "maxConcurrentWorkflows": 2
      }
    }
  ]
}
